# ==============================================================================
# Git Ignore Configuration for CAPTCHA Benchmark Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Datasets & Heavy Raw Data (Never commit to Git - 6.6GB+ BDD100K data)
# ------------------------------------------------------------------------------
challenges/data/
data/
bdd100k/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.h5
*.hdf5
*.parquet
*.feather
*.arrow

# ------------------------------------------------------------------------------
# 2. Challenge Images, Media Assets & Generated Challenge Output
# ------------------------------------------------------------------------------
# Ignore all generated challenges output directory (deterministic; generated via CLI)
challenges/generated/
generated/

# Ignore all image and visual asset files across the repository
*.webp
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.svg
*.tif
*.tiff
*.mp4
*.webm

# Build-time synced challenges in web
web/public/challenges/
public/challenges/
web/src/generated-private/
src/generated-private/
web/src/generated-public/
src/generated-public/

# Explicitly preserve required static template asset for Level 2B:
!challenges/assets/level-2b/checker-shadow.png

# Explicitly preserve benchmark report comparison figures:
!reports/creator-vs-gemini/*.png
!reports/creator-vs-gemini/*.svg

# ------------------------------------------------------------------------------
# 2.5. YouTube Production & Video Assets (Never commit to Git)
# ------------------------------------------------------------------------------
youtube.md
youtube_production/
youtube*/

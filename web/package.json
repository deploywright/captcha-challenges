{
  "name": "captcha-challenges-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "challenges:sync": "tsx scripts/sync-challenges.ts",
    "dev": "npm run challenges:sync && next dev",
    "build": "npm run challenges:sync && next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "preview": "npm run challenges:sync && npm run build:worker && npm run preview:worker",
    "deploy": "npm run challenges:sync && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "test": "vitest run",
    "lint": "next lint"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.145.0"
  }
}

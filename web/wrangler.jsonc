{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captcha-challenges-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "HUMAN_BENCHMARK_DB",
      "database_name": "captcha-human-benchmark",
      "database_id": "a88c2d6f-d809-4de4-beeb-ebf11347dc26",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "persist": false
    }
  }
}
